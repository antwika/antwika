{
    "version": 6,
    "include": [
        "build/CMakePresets.json"
    ],
    "configurePresets": [
        {
            "name": "conan-coverage",
            "inherits": "conan-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "ENABLE_COVERAGE": "ON"
            }
        }
    ]
}