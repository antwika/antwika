{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Conan install",
            "type": "shell",
            "command": "conan install . -of build -pr:b=./profiles/build/${env:CONAN_PROFILE} -pr:h=./profiles/host/${env:CONAN_PROFILE} --build=missing -s build_type=Release --lockfile=conan.lock",
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "CMake preset conan-release",
            "type": "shell",
            "command": "cmake --preset conan-release",
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "CMake preset conan-coverage",
            "type": "shell",
            "command": "cmake --preset conan-coverage",
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "CMake build",
            "type": "shell",
            "command": "cmake --build build",
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "Test",
            "type": "shell",
            "command": "ctest --test-dir build",
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "Gcovr coverage report",
            "type": "shell",
            "command": "mkdir -p build/coverage && gcovr -r . --exclude '.*apps/.*' --exclude '.*/tests/.*' --exclude '.*/mocks/.*' --exclude '.*/fakes/.*' --html --html-details -o build/coverage/index.html",
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "Build",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Conan install",
                "CMake preset conan-release",
                "CMake build",
                "Test"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Coverage",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Conan install",
                "CMake preset conan-coverage",
                "CMake build",
                "Test",
                "Gcovr coverage report"
            ]
        }
    ]
}