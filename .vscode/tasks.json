{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Conan install",
            "type": "shell",
            "command": "conan install . -of build -pr:b=./profiles/build/${env:CONAN_PROFILE} -pr:h=./profiles/host/${env:CONAN_PROFILE} --build=missing -s build_type=Release --lockfile=conan.lock",
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "CMake preset conan-release",
            "type": "shell",
            "command": "cmake --preset conan-release",
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "CMake preset conan-coverage",
            "type": "shell",
            "command": "cmake --preset conan-coverage",
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "CMake build",
            "type": "shell",
            "command": "cmake --build build",
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "CMake build (coverage)",
            "type": "shell",
            "command": "cmake --build build-coverage",
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "Test",
            "type": "shell",
            "command": "ctest --test-dir build --output-on-failure",
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "Test (coverage)",
            "type": "shell",
            "command": "ctest --test-dir build-coverage --output-on-failure",
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "Gcovr coverage report",
            "type": "shell",
            "command": "rm -Rf build-coverage/coverage && mkdir -p build-coverage/coverage && gcovr -r . --filter 'src/.*' --gcov-executable \"${env:GCOV_EXECUTABLE}\" --exclude-throw-branches --exclude-unreachable-branches --exclude '.*/tests/.*' --exclude '.*/mocks/.*' --exclude '.*/fakes/.*' --exclude '.*/apps/[^/]+/src/main\\.cpp' --html --html-details -o build-coverage/coverage/index.html --print-summary build-coverage",
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "Build",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Conan install",
                "CMake preset conan-release",
                "CMake build",
                "Test"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Coverage",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Conan install",
                "CMake preset conan-coverage",
                "CMake build (coverage)",
                "Test (coverage)",
                "Gcovr coverage report"
            ]
        }
    ]
}